lvs "$circuit1 DigitalSine" "$circuit2 DigitalSine" /usr/local/lib/python3.12/dist-packages/librelane/scripts/netgen/setup.tcl /foss/designs/BASIC/current_generator/digital/DigitalSine/runs/RUN_2026-09-18_22-13-25/70-netgen-lvs/reports/lvs.netgen.rpt -blackbox -json
